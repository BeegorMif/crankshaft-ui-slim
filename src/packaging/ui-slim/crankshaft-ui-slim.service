[Unit]
Description=Crankshaft Slim AndroidAuto UI Service
Documentation=https://github.com/opencardev/crankshaft-ui-slim
Requires=dash-server.service
After=graphical-session.target dash-server.service
Wants=crankshaft-core.service

[Service]
Type=notify
NotifyAccess=main
User=crankshaft
Group=crankshaft
ExecStart=/usr/local/bin/crankshaft-ui-slim
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# User/session paths
Environment="HOME=/var/lib/crankshaft/slim-ui"
Environment="XDG_CONFIG_HOME=/var/lib/crankshaft/slim-ui/.config"
Environment="XDG_DATA_HOME=/var/lib/crankshaft/slim-ui/.local/share"
Environment="XDG_STATE_HOME=/var/lib/crankshaft/slim-ui/.local/state"
Environment="XDG_CACHE_HOME=/var/cache/crankshaft"

# Wayland
Environment="XDG_RUNTIME_DIR=/run/user/1001"
Environment="WAYLAND_DISPLAY=wayland-0"
Environment="QT_QPA_PLATFORM=wayland"
Environment="QSG_RHI_BACKEND=opengl"

# Do NOT use the old Pi Chromium flags here.
# QtWebEngine can use the GPU normally on the OptiPlex.
Environment="QTWEBENGINE_CHROMIUM_FLAGS=--ozone-platform=wayland"

# Application
Environment="SLIM_UI_DEBUG=0"
Environment="SLIM_UI_LOG_LEVEL=info"
Environment="SLIM_UI_LOG_FILE=/var/log/crankshaft/ui_slim.log"
Environment="QT_LOGGING_RULES=*.debug=false"

# QML engine settings
Environment="QML_DISABLE_DISK_CACHE=0"
Environment="QML_FORCE_DISK_CACHE=1"

# Audio backend preference
Environment="QT_MULTIMEDIA_PREFERRED_PLUGINS=pulseaudio,alsa"

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/crankshaft /var/log/crankshaft /var/cache/crankshaft
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Resource limits
MemoryMax=200M
CPUQuota=80%

# Watchdog enabled: ui-slim sends READY=1 and periodic WATCHDOG=1 heartbeats.
WatchdogSec=30

[Install]
WantedBy=graphical.target
